#!/bin/sh

# PROVIDE: kazuhahub_radiusd
# REQUIRE: NETWORKING
# KEYWORD: shutdown
#
# The RADIUS proxy for the Kazuha Hub Wi-Fi: the FreeRADIUS daemon of the
# freeradius3 package, run with a private configuration directory so it never
# touches /usr/local/etc/raddb or the radiusd_enable setting.

# The variables below are read by rc.subr.
# shellcheck disable=SC1091,SC2034
. /etc/rc.subr

name="kazuhahub_radiusd"
rcvar="kazuhahub_radiusd_enable"
desc="Kazuha Hub RADIUS proxy"

load_rc_config "$name"
: "${kazuhahub_radiusd_enable:=NO}"

kazuhahub_radiusd_dir="/usr/local/etc/kazuhahub-radius"
kazuhahub_radiusd_check="/usr/local/opnsense/scripts/kazuhahub-radius/check.sh"

command="/usr/local/sbin/radiusd"
command_args="-d ${kazuhahub_radiusd_dir} -n radiusd"
pidfile="/var/run/kazuhahub-radius/radiusd.pid"
required_files="${kazuhahub_radiusd_dir}/radiusd.conf"
extra_commands="reload"
sig_reload="HUP"
start_precmd="kazuhahub_radiusd_prestart"
reload_precmd="kazuhahub_radiusd_prereload"
stop_postcmd="kazuhahub_radiusd_poststop"

# The addresses the generated configuration listens on.
kazuhahub_radiusd_addresses()
{
    sed -n 's/^[[:space:]]*ipaddr = \(.*\)$/\1/p' "${kazuhahub_radiusd_dir}/sites-enabled/default"
}

# At boot the interfaces may come up after this script runs, so give them a
# moment; a listener that cannot bind would stop the daemon.
kazuhahub_radiusd_wait_addresses()
{
    if grep -q '^[[:space:]]*# no-listen-address' "${kazuhahub_radiusd_dir}/sites-enabled/default"; then
        warn "no usable listen interface is selected; select a LAN interface with a static IPv4 address."
        return 1
    fi
    _tries=0
    while :; do
        _missing=""
        for _address in $(kazuhahub_radiusd_addresses); do
            if ! /sbin/ifconfig -a inet | grep -q "inet ${_address} "; then
                _missing="${_missing} ${_address}"
            fi
        done
        [ -z "${_missing}" ] && return 0
        if [ "${_tries}" -ge 30 ]; then
            warn "the listen address is not configured on this firewall:${_missing}"
            return 1
        fi
        sleep 1
        _tries=$((_tries + 1))
    done
}

kazuhahub_radiusd_prestart()
{
    if ! _conflicts="$(/bin/sh "${kazuhahub_radiusd_check}" conflicts)"; then
        warn "refusing to start: ${_conflicts}"
        return 1
    fi
    /bin/sh "${kazuhahub_radiusd_check}" start || return 1
    kazuhahub_radiusd_wait_addresses
}

kazuhahub_radiusd_prereload()
{
    /bin/sh "${kazuhahub_radiusd_check}" start
}

kazuhahub_radiusd_poststop()
{
    rm -f /var/run/kazuhahub-radius/radiusd.sock
}

run_rc_command "$1"
