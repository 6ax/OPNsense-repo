#!/bin/sh
# Removing the transitional package must leave os-kazuhahub-wifi-proxy, its
# settings and its service exactly as they are.
[ -n "${PKG_UPGRADE+x}" ] && exit 0
if [ -x /usr/local/opnsense/scripts/firmware/register.php ]; then
    /usr/local/opnsense/scripts/firmware/register.php remove os-kazuhahub-radius >/dev/null 2>&1 || true
fi
# A restore must not bring the transitional package back.
if [ -f /usr/local/opnsense/scripts/firmware/repos/kazuhahub.sh ]; then
    /bin/sh /usr/local/opnsense/scripts/firmware/repos/kazuhahub.sh forget os-kazuhahub-radius >/dev/null 2>&1 || true
fi
exit 0
