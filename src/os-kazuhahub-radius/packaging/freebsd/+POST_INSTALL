#!/bin/sh
set -eu

if [ -x /usr/local/opnsense/scripts/firmware/register.php ]; then
    /usr/local/opnsense/scripts/firmware/register.php install os-kazuhahub-radius >/dev/null 2>&1 || true
fi
if [ -f /usr/local/opnsense/scripts/firmware/repos/kazuhahub.sh ]; then
    /bin/sh /usr/local/opnsense/scripts/firmware/repos/kazuhahub.sh mirror >/dev/null 2>&1 \
        || echo 'Warning: Kazuha Hub plugin restore manifest could not be updated.' >&2
fi

echo "===> Preparing Kazuha Hub RADIUS"
# The generated configuration holds the shared secrets: only root and the
# daemon's group may enter this directory.
install -d -m 0750 /usr/local/etc/kazuhahub-radius
chgrp freeradius /usr/local/etc/kazuhahub-radius 2>/dev/null || true
chmod 0755 /usr/local/etc/rc.d/kazuhahub_radiusd
chmod 0644 \
	/usr/local/etc/inc/plugins.inc.d/kazuhahubradius.inc \
	/usr/local/opnsense/scripts/kazuhahub-radius/check.sh \
	/usr/local/opnsense/scripts/kazuhahub-radius/export_certs.php \
	/usr/local/opnsense/scripts/kazuhahub-radius/homeservers.php \
	/usr/local/opnsense/service/conf/actions.d/actions_kazuhahubradius.conf \
	/usr/local/opnsense/www/js/widgets/KazuhaHubRadius.js \
	/usr/local/opnsense/www/js/widgets/Metadata/KazuhaHubRadius.xml
find /usr/local/opnsense/mvc/app/controllers/OPNsense/KazuhaHubRadius /usr/local/opnsense/mvc/app/models/OPNsense/KazuhaHubRadius \
	/usr/local/opnsense/mvc/app/views/OPNsense/KazuhaHubRadius /usr/local/opnsense/service/templates/OPNsense/KazuhaHubRadius \
	-type f -exec chmod 0644 {} +

echo "===> Clearing OPNsense menu and ACL cache"
rm -f \
	/var/lib/php/tmp/opnsense_menu_cache.xml \
	/var/lib/php/tmp/opnsense_acl_cache.json

echo "===> Reloading configd actions and templates"
service configd restart >/dev/null 2>&1 || true
# Offers the two central servers and the LAN network on a first install.
/usr/local/opnsense/mvc/script/run_migrations.php OPNsense/KazuhaHubRadius >/dev/null 2>&1 \
    || echo 'Warning: the Kazuha Hub RADIUS defaults could not be created.' >&2
configctl template reload OPNsense/KazuhaHubRadius >/dev/null 2>&1 \
    || echo 'Warning: the Kazuha Hub RADIUS configuration could not be generated.' >&2

# An upgrade, or a reinstall that found its settings in config.xml, resumes; a
# fresh installation stays stopped until the service is enabled.
if grep -qs '^kazuhahub_radiusd_enable="YES"' /etc/rc.conf.d/kazuhahub_radiusd; then
    service kazuhahub_radiusd restart >/dev/null 2>&1 \
        || echo 'Warning: Kazuha Hub RADIUS could not be restarted.' >&2
fi

echo "===> Kazuha Hub RADIUS installed. Refresh the browser and open Services > Kazuha Hub RADIUS."
exit 0
