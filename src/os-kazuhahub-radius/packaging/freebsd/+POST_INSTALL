#!/bin/sh
set -eu
# The proxy itself is os-kazuhahub-wifi-proxy, installed as this package's
# dependency; its first start takes the former settings over from config.xml.
# Registration stays so that the Plugins page lists this package and an
# operator can remove it there once it is no longer needed.
if [ -x /usr/local/opnsense/scripts/firmware/register.php ]; then
    /usr/local/opnsense/scripts/firmware/register.php install os-kazuhahub-radius >/dev/null 2>&1 || true
fi
if [ -f /usr/local/opnsense/scripts/firmware/repos/kazuhahub.sh ]; then
    /bin/sh /usr/local/opnsense/scripts/firmware/repos/kazuhahub.sh mirror >/dev/null 2>&1 || true
fi

# The former service: its package scripts already stopped it, and an upgrade
# keeps its generated files. Make sure no daemon of it is left, then remove
# what it generated: the rc setting, the configuration with its secrets and the
# exported key, the runtime state and the log.
old_pid=/var/run/kazuhahub-radius/radiusd.pid
if [ -s "$old_pid" ] && kill -0 "$(cat "$old_pid")" 2>/dev/null; then
    kill "$(cat "$old_pid")" 2>/dev/null || true
    sleep 2
fi
rm -f /etc/rc.conf.d/kazuhahub_radiusd
rm -rf /usr/local/etc/kazuhahub-radius /var/run/kazuhahub-radius /var/log/kazuhahub-radius
rm -f /var/lib/php/tmp/opnsense_menu_cache.xml /var/lib/php/tmp/opnsense_acl_cache.json
service configd restart >/dev/null 2>&1 || true

# The renamed service may have been installed while the former daemon still
# held port 1812; start it now that the port is free.
if grep -qs '^kazuhahub_wifiproxy_enable="YES"' /etc/rc.conf.d/kazuhahub_wifiproxy; then
    service kazuhahub_wifiproxy restart >/dev/null 2>&1 \
        || echo 'Warning: Kazuha Hub Wi-Fi Proxy could not be restarted.' >&2
fi
exit 0
