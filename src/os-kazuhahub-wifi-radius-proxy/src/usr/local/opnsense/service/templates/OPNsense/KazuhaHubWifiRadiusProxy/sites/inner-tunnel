# Kazuha Hub Wi-Fi RADIUS: the tunnel the EAP-TTLS inner request runs in.
# Rendered from the OPNsense configuration; manual edits are overwritten.
#
# Nothing is authenticated here. The tunneled PAP request is handed to the
# realm that points at the central servers, which answer it.
{% set general = OPNsense.kazuhahubwifiradiusproxy.general if helpers.exists('OPNsense.kazuhahubwifiradiusproxy.general') else {} %}
{# Logins are logged unless the setting is explicitly off; a 1.2.0 configuration has no setting yet. #}
{% set log_logins = (general.get('log_logins') or '1') | string != '0' %}

server inner-tunnel {
	listen {
		ipaddr = 127.0.0.1
		port = 18120
		type = auth
	}

	authorize {
		filter_username
		if (!&User-Password) {
			reject
		}
		update control {
			&Proxy-To-Realm := "ENTRA"
		}
	}

	authenticate {
	}

	post-auth {
{% if log_logins %}
		kazuhahub_login_ok
{% endif %}
		Post-Auth-Type REJECT {
{% if log_logins %}
			kazuhahub_login_incorrect
{% endif %}
			attr_filter.access_reject
		}
	}

	pre-proxy {
	}

	post-proxy {
	}
}
