# Kazuha Hub Wi-Fi RADIUS: the EAP module, EAP-TTLS only.
# Rendered from the OPNsense configuration; manual edits are overwritten.
#
# The certificate files are exported by the rc script before every start, from
# the set synced from the central node while it is valid, else from the OPNsense
# trust store: the leaf followed by the chain in server.pem,
# so the chain is sent to the clients, the key in server.key and the
# authority in ca.pem.

eap {
	default_eap_type = ttls
	timer_expire = 60
	ignore_unknown_eap_types = no
	max_sessions = ${max_requests}

	tls-config tls-common {
		private_key_file = ${certdir}/server.key
		certificate_file = ${certdir}/server.pem
		ca_file = ${cadir}/ca.pem
		cipher_list = "HIGH"
		cipher_server_preference = yes
		tls_min_version = "1.2"
		tls_max_version = "1.3"
		ecdh_curve = ""

		cache {
			enable = no
		}

		ocsp {
			enable = no
		}
	}

	ttls {
		tls = tls-common
		default_eap_type = pap
		copy_request_to_tunnel = no
		use_tunneled_reply = no
		virtual_server = "inner-tunnel"
	}
}
